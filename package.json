    "autoprefixer": "^10.5.0",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.2.9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.0",
    "mongodb-memory-server": "^11.3.0",
    "playwright": "^1.65.1"
  }
}
