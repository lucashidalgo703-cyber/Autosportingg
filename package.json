    "test:seller:access": "node tests/sellerAccessCache.test.js && node tests/integration/sellerAccess.integration.test.js",
    "test:seller:access:browser": "node tests/browser/sellerAccess.browser.mjs",
    "test:roles:access": "node tests/managedRolePermissions.test.js && node tests/integration/managedRoles.integration.test.js",
    "test:roles:access:browser": "node tests/browser/managedRoles.browser.mjs",
    "test:facturacion": "node tests/invoiceFileSelection.test.js && node tests/integration/vehicleInvoices.integration.test.js",
