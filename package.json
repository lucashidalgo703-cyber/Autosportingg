    "test:stock:plates": "node tests/vehiclePlate.test.js && node tests/integration/negotiationPlate.integration.test.js",
    "test:capital:history": "node tests/capitalHistoryPermissions.test.js && node tests/capitalHistoryView.test.js && node tests/integration/capitalHistory.integration.test.js",
